<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Evaluated at execution time: VSSDK properties are not final when this file is imported. -->
  <Target Name="NanoFrameworkStageMetadataProcessorForVsix"
          BeforeTargets="BeforeBuild;GetVsixSourceItems"
          Condition="'$(VssdkCompatibleExtension)' == 'true' or '$(CreateVsixContainer)' == 'true'">
    <ItemGroup>
      <_NanoFrameworkMdpVsixPayload Include="$(MSBuildThisFileDirectory)..\tasks\net472\**\*" />
      <_NanoFrameworkMdpVsixPayload Update="@(_NanoFrameworkMdpVsixPayload)">
        <Link>MetadataProcessor\%(_NanoFrameworkMdpVsixPayload.RecursiveDir)%(_NanoFrameworkMdpVsixPayload.Filename)%(_NanoFrameworkMdpVsixPayload.Extension)</Link>
        <InstallRoot>MSBuild</InstallRoot>
        <VSIXSubPath>nanoFramework\v1.0\%(_NanoFrameworkMdpVsixPayload.RecursiveDir)</VSIXSubPath>
        <IncludeInVSIX>true</IncludeInVSIX>
      </_NanoFrameworkMdpVsixPayload>
      <Content Include="@(_NanoFrameworkMdpVsixPayload)" />
    </ItemGroup>
  </Target>
</Project>
