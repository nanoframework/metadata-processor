<Project DefaultTargets="Verify" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TaskFramework Condition="'$(MSBuildRuntimeType)' == 'Core'">net10.0</TaskFramework>
    <TaskFramework Condition="'$(MSBuildRuntimeType)' != 'Core'">net472</TaskFramework>
  </PropertyGroup>
  <UsingTask TaskName="nanoFramework.Tools.MetadataProcessor.MsBuildTask.MetaDataProcessorTask"
             AssemblyFile="$(PackageRoot)\tasks\$(TaskFramework)\nanoFramework.Tools.MetadataProcessor.MsBuildTask.dll" />
  <PropertyGroup>
    <CreateVsixContainer>true</CreateVsixContainer>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Images\Extension.imagemanifest" />
    <Content Include="Resources\strings.json" />
  </ItemGroup>
  <Import Project="$(PackageRoot)\build\nanoFramework.Tools.MetadataProcessor.MsBuildTask.targets" />
  <Target Name="VerifyVsixStaging" DependsOnTargets="NanoFrameworkStageMetadataProcessorForVsix">
    <ItemGroup>
      <ExpectedPayload Include="$(PackageRoot)\tasks\net472\**\*" />
      <StagedPayload Include="@(Content)" Condition="'%(Content.InstallRoot)' == 'MSBuild'" />
    </ItemGroup>
    <Error Condition="'@(StagedPayload->Count())' != '@(ExpectedPayload->Count())'"
           Text="VSIX staging must add exactly one content item per Framework payload file." />
    <Error Condition="'%(StagedPayload.Link)' != 'MetadataProcessor\%(StagedPayload.RecursiveDir)%(StagedPayload.Filename)%(StagedPayload.Extension)' or
                      '%(StagedPayload.VSIXSubPath)' != 'nanoFramework\v1.0\%(StagedPayload.RecursiveDir)' or
                      '%(StagedPayload.IncludeInVSIX)' != 'true'"
           Text="Invalid VSIX staging metadata for %(StagedPayload.Identity): %(StagedPayload.Link)." />
  </Target>
  <Target Name="Verify" DependsOnTargets="VerifyVsixStaging">
    <Error Condition="'$(PackageRoot)' == '' or '$(Fixture)' == '' or '$(OutputDirectory)' == ''"
           Text="PackageRoot, Fixture and OutputDirectory are required." />
    <MakeDir Directories="$(OutputDirectory)" />
    <ItemGroup>
      <LoadHint Include="$(FixtureDirectory)\*.dll" />
    </ItemGroup>
    <MetaDataProcessorTask Parse="$(Fixture)" Compile="$(OutputDirectory)\Smoke.pe" LoadHints="@(LoadHint)">
      <Output TaskParameter="FilesWritten" ItemName="WrittenFiles" />
    </MetaDataProcessorTask>
    <Error Condition="!Exists('$(OutputDirectory)\Smoke.pe') or !Exists('$(OutputDirectory)\Smoke.pdbx')"
           Text="The packaged task did not generate PE and PDBX output." />
    <Error Condition="'@(WrittenFiles)' == ''" Text="The packaged task did not report FilesWritten." />
  </Target>
</Project>
